// jpm builds itself: `./bootstrap.sh` once, then `bin/jpm build`, `bin/jpm test` and `bin/jpm build --native`.
{
  "name": "jpm",
  "version": "0.4.0",
  "java": "21",
  "main": "dev.jpm.cli.Main",
  // generated with NAME and VERSION from this manifest; Main reads the version from it
  "defineClass": "dev.jpm.BuildConfig",
  "runtime": {},
  "test": {
    "org.junit.jupiter:junit-jupiter": "5.11.4"
  },
  "nativeArgs": [
    "-O2",
    "-H:+ReportExceptionStackTraces",
    "--enable-url-protocols=https,http",
    // The JDK's XML parser (used for POMs) loads its messages from resource bundles at run time.
    "-H:IncludeResourceBundles=com.sun.org.apache.xerces.internal.impl.msg.XMLMessages",
    "-H:IncludeResourceBundles=com.sun.org.apache.xerces.internal.impl.msg.DOMMessages",
    "-H:IncludeResourceBundles=com.sun.org.apache.xerces.internal.impl.xpath.regex.message"
  ]
}
