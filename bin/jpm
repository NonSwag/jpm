#!/bin/sh
# Launcher for the jar build of jpm. The native binary (scripts/native.sh) needs no launcher.
set -eu
here="$(cd "$(dirname "$0")/.." && pwd)"
jar="$(ls -t "$here"/dist/jpm-*.jar 2>/dev/null | head -n 1 || true)"
[ -n "$jar" ] || jar="$here/.cache/bootstrap/jpm.jar"
[ -f "$jar" ] || { echo "jpm is not built yet; run $here/bootstrap.sh" >&2; exit 1; }
exec "${JAVA_HOME:+$JAVA_HOME/bin/}java" -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -Xshare:auto -jar "$jar" "$@"
